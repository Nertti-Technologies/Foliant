<Project>

  <!-- Shared settings for every project in the repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- XML-doc warnings are tracked but not yet enforced pre-1.0 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Quality gate: the recommended .NET analyzer set, and every warning fails the build, so a
         new reliability/maintainability issue is caught locally and in CI rather than by a later
         scan. Rules switched off on purpose are listed with their reasons in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability audit (ADR-0010 T7): a high or critical advisory against any dependency
         (NU1903, NU1904) stays an error and blocks the build and any release. Low and moderate
         advisories (NU1901, NU1902) are reported as warnings, so an advisory published against an
         unchanged dependency does not block an unrelated fix release; they are triaged when seen. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Package version is derived from the git tag by MinVer (configured in src/Directory.Build.props);
       there is no hand-maintained version property. To release: tag vX.Y.Z (see RELEASING.md). -->

</Project>
