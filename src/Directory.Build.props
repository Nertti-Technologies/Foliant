<Project>

  <!-- Inherit repo-root settings -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- NuGet package metadata shared by all shipping packages -->
  <PropertyGroup>
    <!-- Version is derived from the git tag by MinVer (tag prefix "v"); no hand-maintained version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Suresh Subramanian</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>pdf;document-ai;layout-detection;ocr;table-extraction;onnx;document-understanding</PackageTags>
    <PackageProjectUrl>https://github.com/Nerttiyana-Technologies/Foliant</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nerttiyana-Technologies/Foliant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- scripts/generate-notices.py reads IsPackable from each csproj to decide which projects'
         packages ship; it rejects a conditional IsPackable, so keep any opt-out unconditional. -->
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: derives <Version> from the git tag. Not a runtime/package dependency. -->
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)..\PACKAGE_README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <!-- Third-party notices ship in every package. Generated by scripts/generate-notices.py;
         packing fails if the committed file is out of date (target below). -->
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Local and CI gate: packing fails if THIRD-PARTY-NOTICES.txt does not match the restored
       package graph, so a stale notices file can never be packed. Runs on every pack (0.05 s,
       measured): an up-to-date stamp would miss deleted inputs. Needs Python 3.8+ on PATH.
       Coupled to scripts/generate-notices.py's command line; see the note at the top of it. -->
  <PropertyGroup>
    <FoliantPython Condition="'$(OS)' == 'Windows_NT'">py -3</FoliantPython>
    <FoliantPython Condition="'$(OS)' != 'Windows_NT'">python3</FoliantPython>
  </PropertyGroup>
  <Target Name="CheckThirdPartyNotices" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Exec Command="$(FoliantPython) &quot;$(MSBuildThisFileDirectory)../scripts/generate-notices.py&quot; --check" />
  </Target>

</Project>
